from turtle import Turtle, Screen
from random import randint
class RaceTurtle(Turtle):
    def __init__(self, color, positionx, positiony):
        super().__init__()
        self.shape("turtle")
        self.color(color)
        self.penup()
        self.goto(positionx, positiony)
    def randomly(self):
        rand_num = randint(1, 10)
        self.forward(rand_num)

window = Screen()
